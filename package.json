{
	"name": "remote-mcp-server-authless2",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"test:idempiere-db": "node --experimental-strip-types --test scripts/test-idempiere-db.mjs",
		"test:chatgpt-ads": "node --test scripts/test-chatgpt-ads-controls.mjs && node scripts/test-chatgpt-ads-runtime.mjs",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"format": "oxfmt --write .",
		"lint": "oxlint src",
		"lint:fix": "oxlint --fix",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"type-check": "tsc --noEmit",
		"audit:mcp-tools": "node scripts/audit-mcp-tools.mjs",
		"test:mcp-auth": "node scripts/test-mcp-auth.mjs",
		"test:meta-comments": "node --experimental-strip-types --test scripts/test-meta-comments.mjs && node scripts/test-meta-comments-runtime.mjs"
	},
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "1.2.3",
		"@modelcontextprotocol/sdk": "1.30.0",
		"@modelcontextprotocol/server": "2.0.0",
		"agents": "^0.20.1",
		"pg": "8.16.3",
		"zod": "^4.5.0"
	},
	"devDependencies": {
		"@types/pg": "8.15.5",
		"oxfmt": "^0.56.0",
		"oxlint": "^1.71.0",
		"typescript": "6.0.3",
		"wrangler": "^4.105.0"
	}
}
